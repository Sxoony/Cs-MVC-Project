@model IEnumerable<ITEHA3_B33_Project_Tyger_Valley_Campus_EDUV4848998.Models.StaffMember>
@{
    ViewData["Title"] = "Staff Management";
}
@if (TempData["SearchError"] != null)
{
    <div class="alert alert-danger">@TempData["SearchError"]</div>
}
@if (ViewBag.InvalidSearchId == true)
{
    <div class="alert alert-danger">"@ViewBag.SearchId" is not a valid Staff ID format.</div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row mt-3">
    <div class="col-md-3">
        <div class="list-group">
            <a asp-action="Index" class="list-group-item list-group-item-action">List All Staff Members</a>
            <button type="button" class="list-group-item list-group-item-action" onclick="fetchById()">Fetch Staff Member By ID</button>
            <a asp-action="Create" class="list-group-item list-group-item-action">Create/Add a Staff Member</a>
            <button type="button" class="list-group-item list-group-item-action" onclick="editStaff()">Update/Edit Staff Member Details</button>
            <button type="button" class="list-group-item list-group-item-action text-danger" onclick="deleteStaff()">Delete a Staff Member</button>

            <label class="mt-2">Staff ID:</label>
            <input type="text" class="form-control mb-2" id="staffIdInput" placeholder="Enter Staff ID">

            <form asp-controller="Access" asp-action="Logout" method="post">
                <button type="submit" class="list-group-item list-group-item-action text-danger w-100 text-start">Logout</button>
            </form>
        </div>
    </div>

    <div class="col-md-9">
        @if (ViewBag.SearchId != null)
        {
            var staff = ViewBag.SearchResult as ITEHA3_B33_Project_Tyger_Valley_Campus_EDUV4848998.Models.StaffMember;
            if (staff != null)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@staff.FullName</h5>
                        <p class="card-text">
                            <strong>Staff ID:</strong> @staff.StaffId<br />
                            <strong>Email:</strong> @staff.Email<br />
                            <strong>Position:</strong> @staff.Position<br />
                            <strong>Unit:</strong> @staff.Unit
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">No staff member found with ID: @ViewBag.SearchId</div>
            }
        }
        else if (Model != null && Model.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Position</th>
                        <th>Unit</th>
                        <th>Staff ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td>@staff.FullName</td>
                            <td>@staff.Email</td>
                            <td>@staff.Position</td>
                            <td>@staff.Unit</td>
                            <td><code>@staff.StaffId</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No staff members to display. Use the buttons on the left to get started.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function getStaffId() {
            const id = document.getElementById('staffIdInput').value.trim();
            if (!id) {
                alert('Please enter a Staff ID first.');
                return null;
            }
            return id;
        }

        function fetchById() {
            const id = getStaffId();
            if (!id) return;
            window.location.href = '@Url.Action("Index", "Staff")?searchId=' + encodeURIComponent(id);
        }

        function editStaff() {
            const id = getStaffId();
            if (!id) return;
            window.location.href = '@Url.Action("Edit", "Staff")/' + encodeURIComponent(id);
        }

        function deleteStaff() {
            const id = getStaffId();
            if (!id) return;
            if (!confirm('Are you sure you want to delete this staff member? This cannot be undone.')) return;
            window.location.href = '@Url.Action("Delete", "Staff")/' + encodeURIComponent(id);
        }
    </script>
}